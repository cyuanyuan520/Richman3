# Normalize line endings; keep binary assets untouched
* text=auto eol=lf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.mp3  binary
*.wav  binary
*.ogg  binary
*.glb  binary
*.gltf binary
*.bin  binary
*.blend binary
*.zip  binary
*.woff binary
*.woff2 binary

# Shell scripts
*.sh  text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
